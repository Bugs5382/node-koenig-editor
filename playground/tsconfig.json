{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "noEmit": true,
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "verbatimModuleSyntax": true,
    "types": ["node"],
    "paths": {
      "node-koenig-editor": ["../index.d.ts"],
      "node-koenig-editor/styles.css": ["./src/css.d.ts"]
    }
  },
  "include": ["src", "vite.config.ts"]
}
