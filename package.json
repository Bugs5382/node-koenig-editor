{
  "name": "node-koenig-editor",
  "version": "1.2.0",
  "description": "Ghost's Koenig editor on Lexical 0.52 and React 19, packaged for reuse, with optional Yjs collaboration.",
  "author": "Shane",
  "license": "MIT",
  "type": "module",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./styles.css": "./dist/styles.css"
  },
  "files": [
    "dist",
    "LICENSE-koenig"
  ],
  "sideEffects": [
    "*.css"
  ],
  "config": {
    "packMaxUnpackedBytes": 1110000,
    "packMaxGrowthPercent": 25
  },
  "engines": {
    "node": ">=22.13"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Bugs5382/node-koenig-editor.git"
  },
  "homepage": "https://github.com/Bugs5382/node-koenig-editor#readme",
  "bugs": {
    "url": "https://github.com/Bugs5382/node-koenig-editor/issues"
  },
  "keywords": [
    "koenig",
    "lexical",
    "react",
    "editor",
    "rich-text",
    "yjs",
    "collaboration"
  ],
  "scripts": {
    "build": "vite build",
    "build:css": "node scripts/build-css.mjs",
    "check:pack": "node scripts/checkPack.mjs",
    "check:pack:growth": "node scripts/checkPackGrowth.mjs",
    "check:install": "node scripts/checkInstall.mjs",
    "clean": "rm -rf dist docs coverage",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "docs": "typedoc",
    "playground": "node playground/scripts/run.mjs",
    "playground:published": "node playground/scripts/run.mjs --published",
    "playground:check": "npm --prefix playground run lint && npm --prefix playground run typecheck && npm --prefix playground test && npm --prefix playground run build"
  },
  "peerDependencies": {
    "@lexical/clipboard": "^0.52.0",
    "@lexical/code": "^0.52.0",
    "@lexical/code-prism": "^0.52.0",
    "@lexical/html": "^0.52.0",
    "@lexical/link": "^0.52.0",
    "@lexical/list": "^0.52.0",
    "@lexical/mark": "^0.52.0",
    "@lexical/markdown": "^0.52.0",
    "@lexical/react": "^0.52.0",
    "@lexical/rich-text": "^0.52.0",
    "@lexical/selection": "^0.52.0",
    "@lexical/table": "^0.52.0",
    "@lexical/text": "^0.52.0",
    "@lexical/utils": "^0.52.0",
    "@lexical/yjs": "^0.52.0",
    "lexical": "^0.52.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "yjs": "^13.6.31"
  },
  "dependencies": {
    "@tryghost/kg-clean-basic-html": "^4.3.5",
    "clsx": "^2.1.1",
    "dompurify": "^3.4.16",
    "eventemitter3": "^5.0.4",
    "lodash": "^4.18.1",
    "markdown-it": "^14.3.3",
    "react-error-boundary": "^6.1.6",
    "react-file-icon": "^1.6.0",
    "unicode-emoji-json": "^0.9.0"
  },
  "devDependencies": {
    "@bugs5382/node-oxlint-config": "^1.0.1",
    "@lexical/clipboard": "^0.52.0",
    "@lexical/code": "^0.52.0",
    "@lexical/code-prism": "^0.52.0",
    "@lexical/html": "^0.52.0",
    "@lexical/link": "^0.52.0",
    "@lexical/list": "^0.52.0",
    "@lexical/mark": "^0.52.0",
    "@lexical/markdown": "^0.52.0",
    "@lexical/react": "^0.52.0",
    "@lexical/rich-text": "^0.52.0",
    "@lexical/selection": "^0.52.0",
    "@lexical/table": "^0.52.0",
    "@lexical/text": "^0.52.0",
    "@lexical/utils": "^0.52.0",
    "@lexical/yjs": "^0.52.0",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/lodash": "^4.17.25",
    "@types/markdown-it": "^14.2.0",
    "@types/node": "^22.10.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/react-file-icon": "^1.0.5",
    "@vitejs/plugin-react": "^6.1.2",
    "jsdom": "^30.1.2",
    "lexical": "^0.52.0",
    "oxfmt": "^0.77.0",
    "oxlint": "^1.92.0",
    "postcss": "^8.5.29",
    "postcss-import": "^16.2.0",
    "react": "^19.3.0",
    "react-colorful": "^5.8.1",
    "react-dom": "^19.3.0",
    "tailwindcss": "^3.4.19",
    "typedoc": "^0.28.20",
    "typescript": "^5.7.2",
    "vite": "^8.3.2",
    "vite-plugin-svgr": "^5.2.0",
    "vitest": "^5.0.3",
    "yjs": "^13.6.31"
  }
}
