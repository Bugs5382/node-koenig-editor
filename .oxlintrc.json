{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "extends": [
    "./node_modules/@bugs5382/node-oxlint-config/configs/base.json"
  ],
  "ignorePatterns": [
    "dist/**",
    "coverage/**",
    "docs/**",
    "playground/**",
    "src/koenig-lexical/**",
    "src/kg-default-nodes/**",
    "src/kg-default-transforms/**",
    "src/generated/**",
    "tailwind.config.cjs"
  ],
  "overrides": [
    {
      "files": [
        "**/*.{js,mjs,cjs,ts,tsx,jsx}"
      ],
      "rules": {
        "import/no-default-export": "off",
        "perfectionist/sort-array-includes": "off",
        "perfectionist/sort-classes": "off",
        "perfectionist/sort-exports": "off",
        "perfectionist/sort-imports": "off",
        "perfectionist/sort-interfaces": "off",
        "perfectionist/sort-intersection-types": "off",
        "perfectionist/sort-jsx-props": "off",
        "perfectionist/sort-maps": "off",
        "perfectionist/sort-modules": "off",
        "perfectionist/sort-named-exports": "off",
        "perfectionist/sort-named-imports": "off",
        "perfectionist/sort-object-types": "off",
        "perfectionist/sort-objects": "off",
        "perfectionist/sort-switch-case": "off",
        "perfectionist/sort-union-types": "off",
        "react-js/prop-types": "off",
        "unicorn-js/better-dom-traversing": "off",
        "unicorn-js/dom-node-dataset": "off",
        "unicorn-js/no-incorrect-query-selector": "off",
        "unicorn-js/no-this-outside-of-class": "off",
        "unicorn-js/prefer-https": "off",
        "unicorn-js/prefer-includes-over-repeated-comparisons": "off",
        "unicorn-js/prefer-split-limit": "off",
        "unicorn-js/prefer-string-repeat": "off",
        "unicorn-js/prevent-abbreviations": "off",
        "unicorn-js/require-css-escape": "off",
        "unicorn/consistent-existence-index-check": "off",
        "unicorn/consistent-function-scoping": "off",
        "unicorn/escape-case": "off",
        "unicorn/explicit-length-check": "off",
        "unicorn/filename-case": "off",
        "unicorn/import-style": "off",
        "unicorn/no-array-callback-reference": "off",
        "unicorn/no-array-for-each": "off",
        "unicorn/no-array-reduce": "off",
        "unicorn/no-array-reverse": "off",
        "unicorn/no-array-sort": "off",
        "unicorn/no-await-expression-member": "off",
        "unicorn/no-negated-condition": "off",
        "unicorn/no-nested-ternary": "off",
        "unicorn/no-null": "off",
        "unicorn/no-object-as-default-parameter": "off",
        "unicorn/no-useless-collection-argument": "off",
        "unicorn/no-useless-spread": "off",
        "unicorn/no-useless-undefined": "off",
        "unicorn/numeric-separators-style": "off",
        "unicorn/prefer-add-event-listener": "off",
        "unicorn/prefer-array-find": "off",
        "unicorn/prefer-at": "off",
        "unicorn/prefer-code-point": "off",
        "unicorn/prefer-dom-node-append": "off",
        "unicorn/prefer-dom-node-remove": "off",
        "unicorn/prefer-global-this": "off",
        "unicorn/prefer-logical-operator-over-ternary": "off",
        "unicorn/prefer-math-trunc": "off",
        "unicorn/prefer-modern-dom-apis": "off",
        "unicorn/prefer-module": "off",
        "unicorn/prefer-number-properties": "off",
        "unicorn/prefer-query-selector": "off",
        "unicorn/prefer-single-call": "off",
        "unicorn/prefer-spread": "off",
        "unicorn/prefer-string-raw": "off",
        "unicorn/prefer-string-replace-all": "off",
        "unicorn/require-array-join-separator": "off",
        "unicorn/switch-case-braces": "off"
      }
    }
  ],
  "settings": {
    "react": {
      "version": "19.3"
    }
  }
}
